datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  bio       String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id            Int          @id @default(autoincrement())
  title         String
  description   String?
  url           String
  upvotes       Int          @default(0)       // 🌟 Curtidas (Etapa 2)
  averageRating Float        @default(0.0)     // 📈 Média de notas (Etapa 2)
  createdAt     DateTime     @default(now())
  profileId     Int
  profile       Profile      @relation(fields: [profileId], references: [id])
  technologies  Technology[]
  feedbacks     Feedback[]
}

model Technology {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  projects Project[]
}

model Feedback {
  id        Int      @id @default(autoincrement())
  author    String
  comment   String
  rating    Int      // ⭐ Nota de 1 a 5 (Etapa 2)
  createdAt DateTime @default(now())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
}
